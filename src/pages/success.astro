---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const title = 'Thank You | SAM HANDY DO';
const description = 'Thank you for contacting SAM HANDY DO. We will get back to you shortly.';
---

<Layout title={title} description={description} canonicalPath="/success/">
	<div class="min-h-screen hero-premium flex items-center justify-center px-6">
		<div class="max-w-md w-full bg-forest-deep/80 backdrop-blur border border-gold/20 rounded-2xl p-10 md:p-12 text-center shadow-2xl">
			<img src="/logo.png" alt="" width="80" height="80" class="w-20 h-20 mx-auto mb-8 object-contain" aria-hidden="true" />
			<h1 class="font-serif text-4xl text-ivory font-medium mb-2">Thank you</h1>
			<p class="font-serif text-xl italic text-gold-light mb-4">Your message is on its way.</p>
			<p class="font-sans text-ivory/60 text-sm leading-relaxed mb-10">
				We'll review your enquiry and respond with a quote and availability soon.
			</p>
			<Button href="/" variant="gold">Return Home</Button>
		</div>
	</div>
</Layout>
