---
import { SITE } from '../data/site';
import Button from './Button.astro';
---

<section id="about" class="bg-ivory py-24 md:py-32">
	<div class="max-w-3xl mx-auto px-6 lg:px-8">
		<p class="font-sans text-xs uppercase tracking-[0.3em] text-gold-deep mb-3">About Sam</p>
		<h2 class="font-serif text-4xl md:text-[2.75rem] text-forest font-medium leading-tight mb-6">
			The person who can<br />
			<span class="italic text-gold-deep">do it all.</span>
		</h2>
		<p class="font-sans text-ink-soft leading-relaxed mb-5">
			SAM HANDY DO is built around a simple idea: your home and garden deserve the same
			level of care. Not a different trade for every room — one experienced craftsman
			who understands the whole property.
		</p>
		<p class="font-sans text-ink-soft leading-relaxed mb-8">
			Whether it's fixing a door, planting a border, or refreshing an entire outdoor space —
			every job is approached with patience, skill, and respect for your home.
		</p>
		<Button href="#contact">Start a Conversation</Button>
	</div>
</section>

<!-- CTA band -->
<section class="bg-forest-deep py-16 border-y border-gold/10">
	<div class="max-w-4xl mx-auto px-6 text-center">
		<p class="font-serif text-2xl md:text-3xl text-ivory font-medium leading-snug mb-2">
			Home repairs. Garden care. One golden pair of hands.
		</p>
		<p class="font-sans text-ivory/50 text-sm">
			{SITE.areasServed.join(' · ')} · Ireland
		</p>
	</div>
</section>
