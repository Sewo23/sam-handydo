---
import Button from './Button.astro';
---

<header
	data-site-nav
	class="site-nav fixed w-full z-50 transition-all duration-500 border-b border-transparent"
>
	<div class="max-w-6xl mx-auto px-6 lg:px-8">
		<div class="flex justify-between items-center h-20">
			<a href="/" class="flex items-center gap-3 group">
				<div class="relative">
					<div class="logo-halo absolute -inset-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
					<img
						src="/logo.png"
						alt="SAM HANDY DO"
						width="48"
						height="48"
						class="relative w-11 h-11 object-contain transition-transform duration-500 group-hover:scale-105"
					/>
				</div>
				<div class="hidden sm:block">
					<p class="font-serif text-xl font-semibold tracking-wide text-ivory leading-none">
						Sam Handy Do
					</p>
					<p class="text-[10px] uppercase tracking-[0.25em] text-gold-muted mt-0.5 font-sans">
						Home & Garden
					</p>
				</div>
			</a>

			<nav class="hidden lg:flex items-center gap-10" aria-label="Main">
				<a href="#services" class="nav-link text-sm font-sans text-ivory/75 hover:text-gold-light transition-colors">Services</a>
				<a href="#about" class="nav-link text-sm font-sans text-ivory/75 hover:text-gold-light transition-colors">About</a>
				<a href="#process" class="nav-link text-sm font-sans text-ivory/75 hover:text-gold-light transition-colors">Process</a>
				<Button href="#contact" size="sm">Request a Quote</Button>
			</nav>

			<a
				href="#contact"
				class="lg:hidden text-xs font-sans font-semibold uppercase tracking-wider text-gold border border-gold/50 rounded-full px-4 py-2 hover:bg-gold/10 transition-colors"
			>
				Quote
			</a>
		</div>
	</div>
</header>

<style>
	.site-nav {
		background: transparent;
	}

	.site-nav.is-scrolled {
		background: rgba(18, 36, 25, 0.92);
		backdrop-filter: blur(16px);
		border-color: rgba(196, 160, 53, 0.15);
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-site-nav]');
	if (nav) {
		const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 48);
		update();
		window.addEventListener('scroll', update, { passive: true });
		document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', update));
	}
</script>
