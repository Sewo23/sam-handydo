---
import { SITE } from '../data/site';
import Button from './Button.astro';

const whatsappUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappDefaultMessage)}`;
---

<section id="contact" class="bg-champagne py-24 md:py-32">
	<div class="max-w-6xl mx-auto px-6 lg:px-8">
		<div class="text-center mb-14">
			<p class="font-sans text-xs uppercase tracking-[0.3em] text-gold-deep mb-3">Get in Touch</p>
			<h2 class="font-serif text-4xl md:text-5xl text-forest font-medium">Let's talk about your property</h2>
		</div>

		<div class="grid lg:grid-cols-5 gap-10 lg:gap-14">
			<div class="lg:col-span-2 space-y-8">
				<p class="font-sans text-ink-soft leading-relaxed">
					Describe what you need — indoors, outdoors, or both. We'll respond with a clear quote
					and a time that works for you.
				</p>

				<dl class="space-y-6 font-sans">
					<div>
						<dt class="text-[10px] uppercase tracking-[0.2em] text-gold-deep mb-1">Phone</dt>
						<dd>
							<a href={`tel:${SITE.phone}`} class="text-forest text-lg hover:text-gold-deep transition-colors">
								{SITE.phoneDisplay}
							</a>
						</dd>
					</div>
					<div>
						<dt class="text-[10px] uppercase tracking-[0.2em] text-gold-deep mb-1">Email</dt>
						<dd>
							<a href={`mailto:${SITE.email}`} class="text-forest hover:text-gold-deep transition-colors">
								{SITE.email}
							</a>
						</dd>
					</div>
					<div>
						<dt class="text-[10px] uppercase tracking-[0.2em] text-gold-deep mb-1">Areas</dt>
						<dd class="text-ink-soft text-sm">{SITE.areasServed.join(', ')}</dd>
					</div>
				</dl>

				<a
					href={whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-3.5 text-sm font-sans font-semibold text-white hover:bg-[#1da851] transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
					</svg>
					Message on WhatsApp
				</a>
			</div>

			<div class="lg:col-span-3 bg-ivory border border-stone rounded-2xl p-8 md:p-10 shadow-sm">
				<form
					name="contact"
					method="POST"
					data-netlify="true"
					data-netlify-honeypot="bot-field"
					netlify-honeypot="bot-field"
					action="/success/"
					class="space-y-5"
				>
					<input type="hidden" name="form-name" value="contact" />
					<p class="hidden" style="display: none;">
						<label>Don't fill this out: <input name="bot-field" /></label>
					</p>

					<div class="grid sm:grid-cols-2 gap-5">
						<div>
							<label for="contact-name" class="block font-sans text-xs uppercase tracking-wider text-ink-soft mb-2">Name</label>
							<input type="text" id="contact-name" name="name" required
								class="w-full bg-champagne/50 border border-stone rounded-lg px-4 py-3 font-sans text-forest focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition" />
						</div>
						<div>
							<label for="contact-email" class="block font-sans text-xs uppercase tracking-wider text-ink-soft mb-2">Email</label>
							<input type="email" id="contact-email" name="email" required
								class="w-full bg-champagne/50 border border-stone rounded-lg px-4 py-3 font-sans text-forest focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition" />
						</div>
					</div>
					<div>
						<label for="contact-phone" class="block font-sans text-xs uppercase tracking-wider text-ink-soft mb-2">Phone</label>
						<input type="tel" id="contact-phone" name="phone"
							class="w-full bg-champagne/50 border border-stone rounded-lg px-4 py-3 font-sans text-forest focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition" />
					</div>
					<div>
						<label for="contact-message" class="block font-sans text-xs uppercase tracking-wider text-ink-soft mb-2">Your Project</label>
						<textarea id="contact-message" name="message" rows="4" required
							placeholder="Tell us about your home or garden project..."
							class="w-full bg-champagne/50 border border-stone rounded-lg px-4 py-3 font-sans text-forest focus:outline-none focus:ring-2 focus:ring-gold/40 focus:border-gold transition resize-none"></textarea>
					</div>
					<div>
						<label for="contact-gdpr-consent" class="flex items-start gap-3 text-sm text-ink-soft leading-relaxed cursor-pointer font-sans">
							<input type="checkbox" id="contact-gdpr-consent" name="gdpr-consent" value="yes" required
								class="mt-1 rounded border-stone text-gold focus:ring-gold" />
							<span>
								I consent to SAM HANDY DO using my details to respond.{' '}
								<a href="/privacy-policy/" class="text-gold-deep underline hover:text-gold">Privacy Policy</a>.
							</span>
						</label>
					</div>
					<Button type="submit" size="lg" class="w-full sm:w-auto">Send Enquiry</Button>
				</form>
			</div>
		</div>
	</div>
</section>

<form name="contact" data-netlify="true" data-netlify-honeypot="bot-field" netlify-honeypot="bot-field" hidden>
	<input type="text" name="name" />
	<input type="email" name="email" />
	<input type="tel" name="phone" />
	<textarea name="message"></textarea>
	<input type="checkbox" name="gdpr-consent" value="yes" />
	<input type="text" name="bot-field" />
</form>
