---
import { pillars } from '../data/site';

const icons = {
	home: `<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-7h6v7"/>`,
	garden: `<path d="M12 21V11"/><path d="M12 11c-3.5-1-6-4-6-7 3.5 0 6 2.5 6 5.5"/><path d="M12 11c3.5-1 6-4 6-7-3.5 0-6 2.5-6 5.5"/><path d="M8 21h8"/>`,
	hands: `<path d="M8 13V7a2 2 0 1 1 4 0v4"/><path d="M12 11V5a2 2 0 1 1 4 0v8"/><path d="M16 13V9a2 2 0 1 1 4 0v7a6 6 0 0 1-6 6h-1.5a6 6 0 0 1-5.2-3L5 15a2 2 0 0 1 3-2.5L8 13"/>`,
	paint: `<path d="M14 3H6a2 2 0 0 0-2 2v4h12V5a2 2 0 0 0-2-2Z"/><path d="M4 9v2a2 2 0 0 0 2 2h1v6a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-6h1a2 2 0 0 0 2-2V9"/>`,
	fence: `<path d="M4 21V8l4-3 4 3 4-3 4 3v13"/><path d="M4 12h16"/><path d="M8 21V10"/><path d="M12 21V10"/><path d="M16 21V10"/>`,
	tools: `<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2-2 2.5-2.5Z"/>`,
} as const;

type IconKey = keyof typeof icons;

const slides = [...pillars, ...pillars];
---

<section class="bg-ivory pt-8 md:pt-10 pb-16 md:pb-20 overflow-hidden" data-work-carousel>
	<div class="max-w-6xl mx-auto px-6 lg:px-8 mb-6 md:mb-8">
		<div class="max-w-2xl">
			<p class="font-sans text-xs uppercase tracking-[0.3em] text-gold-deep mb-2">The Complete Picture</p>
			<h2 class="font-serif text-3xl md:text-4xl text-forest font-medium leading-tight">
				One craftsman.<br />Every corner of your property.
			</h2>
			<p class="mt-2 font-sans text-sm text-ink-soft">
				Films drift slowly — tap one to enlarge and play.
			</p>
		</div>
	</div>

	<div class="relative">
		<div class="carousel-fade carousel-fade-left" aria-hidden="true"></div>
		<div class="carousel-fade carousel-fade-right" aria-hidden="true"></div>

		<div
			class="carousel-viewport overflow-hidden"
			data-carousel-viewport
			role="region"
			aria-label="Work showcase carousel"
		>
			<div class="carousel-rail flex gap-5 md:gap-6 w-max will-change-transform" data-carousel-rail>
				{
					slides.map((pillar, index) => {
						const icon = icons[pillar.icon as IconKey] ?? icons.tools;
						const key = `${pillar.title}-${index}`;
						return (
							<article class="carousel-slide shrink-0 w-[62vw] sm:w-[240px] md:w-[280px]">
								<button
									type="button"
									class="media-well group relative block w-full aspect-[3/4] overflow-hidden rounded-2xl bg-forest-deep border border-gold/20 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
									data-open-film
									data-title={pillar.title}
									data-subtitle={pillar.subtitle}
									data-description={pillar.description}
									data-video={pillar.video || ''}
									data-poster={pillar.poster || ''}
									aria-label={`Open ${pillar.title}`}
								>
									{pillar.video ? (
										<video
											class="absolute inset-0 h-full w-full object-cover pointer-events-none"
											src={pillar.video}
											poster={pillar.poster || undefined}
											muted
											playsinline
											loop
											preload="metadata"
											data-carousel-preview
										/>
									) : (
										<div class="absolute inset-0" aria-hidden="true">
											<div
												class="absolute inset-0"
												style="background: radial-gradient(circle at 30% 25%, rgba(196,160,53,0.22), transparent 55%), linear-gradient(160deg, #122419, #1a3328 55%, #2a4a3a);"
											/>
											<div class="absolute inset-0 flex items-center justify-center">
												<span class="inline-flex h-14 w-14 items-center justify-center rounded-full border border-gold/35 text-gold-light transition-transform duration-300 group-hover:scale-110">
													<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7L8 5z" /></svg>
												</span>
											</div>
										</div>
									)}

									<div class="absolute inset-x-0 bottom-0 p-5 md:p-6 bg-gradient-to-t from-forest-deep via-forest-deep/85 to-transparent">
										<div class="flex items-center gap-3 mb-3">
											<span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 text-gold-light bg-forest-deep/50 backdrop-blur-sm">
												<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
											</span>
											<p class="font-sans text-[10px] uppercase tracking-[0.25em] text-gold-light/90">{pillar.subtitle}</p>
										</div>
										<h3 class="font-serif text-2xl text-ivory font-medium mb-2">{pillar.title}</h3>
										<p class="font-sans text-sm text-ivory/65 leading-relaxed line-clamp-2">{pillar.description}</p>
									</div>
								</button>
							</article>
						);
					})
				}
			</div>
		</div>
	</div>

	<!-- Expanded film lightbox -->
	<dialog
		class="film-lightbox m-0 max-w-none w-full h-full bg-transparent p-0 backdrop:bg-forest-deep/80"
		data-film-lightbox
		aria-label="Expanded film"
	>
		<div class="film-lightbox-shell flex min-h-full items-center justify-center p-4 md:p-8">
			<div class="relative w-full max-w-4xl overflow-hidden rounded-2xl border border-gold/25 bg-forest-deep shadow-2xl shadow-black/40">
				<button
					type="button"
					class="absolute top-3 right-3 z-20 inline-flex h-10 w-10 items-center justify-center rounded-full border border-gold/30 bg-forest-deep/80 text-ivory hover:border-gold hover:text-gold-light"
					data-close-film
					aria-label="Close"
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
				</button>

				<div class="relative aspect-video bg-black">
					<video
						class="absolute inset-0 h-full w-full object-contain"
						controls
						playsinline
						data-lightbox-video
					></video>
					<div
						class="absolute inset-0 flex items-center justify-center bg-forest-deep"
						data-lightbox-empty
						hidden
					>
						<p class="font-sans text-sm uppercase tracking-[0.25em] text-ivory/50">Short film coming soon</p>
					</div>
				</div>

				<div class="p-5 md:p-6 border-t border-gold/15">
					<p class="font-sans text-[10px] uppercase tracking-[0.25em] text-gold-light mb-2" data-lightbox-subtitle></p>
					<h3 class="font-serif text-2xl md:text-3xl text-ivory font-medium mb-2" data-lightbox-title></h3>
					<p class="font-sans text-sm text-ivory/65 leading-relaxed" data-lightbox-description></p>
				</div>
			</div>
		</div>
	</dialog>
</section>

<style>
	.carousel-viewport {
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}

	.carousel-rail {
		animation: filmDrift 55s linear infinite;
	}

	.carousel-viewport.is-paused .carousel-rail,
	[data-work-carousel].is-lightbox-open .carousel-rail {
		animation-play-state: paused;
	}

	@keyframes filmDrift {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	.carousel-fade {
		pointer-events: none;
		position: absolute;
		top: 0;
		bottom: 1rem;
		width: 3rem;
		z-index: 2;
	}

	.carousel-fade-left {
		left: 0;
		background: linear-gradient(90deg, #faf8f4, transparent);
	}

	.carousel-fade-right {
		right: 0;
		background: linear-gradient(270deg, #faf8f4, transparent);
	}

	.media-well {
		cursor: pointer;
		transition: transform 0.35s ease, box-shadow 0.35s ease;
	}

	.media-well:hover {
		transform: translateY(-3px);
		box-shadow: 0 18px 40px -18px rgba(18, 36, 25, 0.45);
	}

	.film-lightbox[open] {
		display: block;
	}

	.film-lightbox::backdrop {
		background: rgba(18, 36, 25, 0.82);
		backdrop-filter: blur(6px);
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-rail {
			animation: none;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-work-carousel]');
	if (!root) return;

	const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]');
	const lightbox = root.querySelector<HTMLDialogElement>('[data-film-lightbox]');
	const closeBtn = root.querySelector<HTMLButtonElement>('[data-close-film]');
	const lightboxVideo = root.querySelector<HTMLVideoElement>('[data-lightbox-video]');
	const emptyState = root.querySelector<HTMLElement>('[data-lightbox-empty]');
	const titleEl = root.querySelector<HTMLElement>('[data-lightbox-title]');
	const subtitleEl = root.querySelector<HTMLElement>('[data-lightbox-subtitle]');
	const descEl = root.querySelector<HTMLElement>('[data-lightbox-description]');
	if (!viewport || !lightbox || !lightboxVideo || !emptyState || !titleEl || !subtitleEl || !descEl) return;

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	viewport.addEventListener('pointerenter', () => viewport.classList.add('is-paused'));
	viewport.addEventListener('pointerleave', () => {
		if (!root.classList.contains('is-lightbox-open')) viewport.classList.remove('is-paused');
	});

	const previews = root.querySelectorAll<HTMLVideoElement>('[data-carousel-preview]');
	previews.forEach((video) => {
		void video.play().catch(() => {});
	});

	const openFilm = (btn: HTMLButtonElement) => {
		const title = btn.dataset.title ?? '';
		const subtitle = btn.dataset.subtitle ?? '';
		const description = btn.dataset.description ?? '';
		const videoSrc = btn.dataset.video ?? '';
		const poster = btn.dataset.poster ?? '';

		titleEl.textContent = title;
		subtitleEl.textContent = subtitle;
		descEl.textContent = description;

		root.classList.add('is-lightbox-open');
		viewport.classList.add('is-paused');

		if (videoSrc) {
			emptyState.hidden = true;
			lightboxVideo.hidden = false;
			lightboxVideo.src = videoSrc;
			lightboxVideo.poster = poster;
			lightboxVideo.currentTime = 0;
			lightbox.showModal();
			void lightboxVideo.play().catch(() => {});
		} else {
			lightboxVideo.pause();
			lightboxVideo.removeAttribute('src');
			lightboxVideo.load();
			lightboxVideo.hidden = true;
			emptyState.hidden = false;
			lightbox.showModal();
		}
	};

	const closeFilm = () => {
		lightboxVideo.pause();
		lightboxVideo.removeAttribute('src');
		lightboxVideo.load();
		lightbox.close();
		root.classList.remove('is-lightbox-open');
		viewport.classList.remove('is-paused');
	};

	root.querySelectorAll<HTMLButtonElement>('[data-open-film]').forEach((btn) => {
		btn.addEventListener('click', () => openFilm(btn));
	});

	closeBtn?.addEventListener('click', closeFilm);

	lightbox.addEventListener('click', (e) => {
		const shell = lightbox.querySelector('.film-lightbox-shell');
		if (e.target === shell || e.target === lightbox) closeFilm();
	});

	lightbox.addEventListener('cancel', (e) => {
		e.preventDefault();
		closeFilm();
	});

	if (reduce) {
		viewport.classList.add('is-paused');
	}
</script>
