---
import { pillars } from '../data/site';
---

<section class="bg-ivory py-20 md:py-28">
	<div class="max-w-6xl mx-auto px-6 lg:px-8">
		<div class="text-center max-w-2xl mx-auto mb-16">
			<p class="font-sans text-xs uppercase tracking-[0.3em] text-gold-deep mb-3">The Complete Picture</p>
			<h2 class="font-serif text-4xl md:text-5xl text-forest font-medium leading-tight">
				One craftsman.<br />Every corner of your property.
			</h2>
		</div>

		<div class="grid md:grid-cols-3 gap-8 md:gap-6">
			{
				pillars.map((pillar, i) => (
					<article class="card-premium relative bg-champagne/50 border border-stone rounded-2xl p-8 md:p-10 text-center">
						<span class="font-serif text-5xl text-gold/30 absolute top-6 right-8 leading-none select-none" aria-hidden="true">
							{i + 1}
						</span>
						<p class="font-sans text-[10px] uppercase tracking-[0.25em] text-gold-deep mb-2">{pillar.subtitle}</p>
						<h3 class="font-serif text-2xl md:text-3xl text-forest font-medium mb-4">{pillar.title}</h3>
						<p class="font-sans text-ink-soft text-sm leading-relaxed">{pillar.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
