---
import Button from './Button.astro';
import { SITE } from '../data/site';

const areas = [...SITE.areasServed, ...SITE.areasServed];
---

<section class="hero-premium relative min-h-[52svh] lg:min-h-[48svh] flex flex-col overflow-hidden" data-hero>
	<!-- Parallax atmosphere -->
	<div class="hero-parallax absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true" data-hero-parallax>
		<div class="hero-orb hero-orb-a absolute -top-16 -right-16 w-[360px] h-[360px] rounded-full border border-gold/10"></div>
		<div class="hero-orb hero-orb-b absolute bottom-0 left-0 w-[280px] h-[280px] rounded-full border border-sage/10 translate-y-1/2 -translate-x-1/4"></div>
		<div class="absolute inset-0 hero-premium-glow"></div>
	</div>

	<div class="relative flex-1 flex items-center max-w-6xl mx-auto w-full px-6 lg:px-8 pt-24 pb-6 lg:pt-24 lg:pb-8">
		<div class="grid grid-cols-12 gap-4 sm:gap-6 lg:gap-10 items-center w-full">
			<div class="col-span-7 min-w-0">
				<p class="hero-stagger hero-stagger-1 font-sans text-[10px] sm:text-xs uppercase tracking-[0.35em] text-gold-light mb-3">
					Premium Craftsman · Ireland
				</p>

				<h1 class="hero-stagger hero-stagger-2 font-serif font-semibold text-ivory leading-[1.05] mb-3">
					<span class="block text-[clamp(1.55rem,3.8vw,3.25rem)]">One craftsman for</span>
					<span class="block text-[clamp(1.7rem,4.2vw,3.75rem)] italic text-gold-light">your entire property.</span>
				</h1>

				<p class="hero-stagger hero-stagger-3 font-sans text-ivory/70 text-sm sm:text-base md:text-lg leading-relaxed max-w-lg mb-5 sm:mb-6">
					Repairs inside, care outside. One trusted pair of hands for the jobs that keep your home feeling complete.
				</p>

				<div class="hero-stagger hero-stagger-4 flex flex-wrap gap-2 sm:gap-3">
					<Button href="#contact" size="md">Book a Consultation</Button>
					<Button href="#services" variant="outline" size="md" class="btn-ghost-hero">Explore Services</Button>
				</div>
			</div>

			<div class="col-span-5 flex justify-end items-center hero-stagger hero-stagger-5">
				<div class="relative flex flex-col items-center" data-hero-float>
					<div class="absolute inset-0 logo-halo scale-150 opacity-70" aria-hidden="true"></div>
					<img
						src="/logo.png"
						alt=""
						width="420"
						height="420"
						class="relative w-[clamp(7.5rem,22vw,20rem)] h-[clamp(7.5rem,22vw,20rem)] object-contain"
						aria-hidden="true"
					/>
					<p class="mt-2 sm:mt-3 font-serif text-center text-ivory/85 text-[clamp(0.7rem,1.6vw,1.15rem)] italic leading-snug">
						Golden hands for<br />home & garden
					</p>
				</div>
			</div>
		</div>
	</div>

	<!-- Thin location marquee -->
	<div class="hero-marquee relative border-t border-gold/10 bg-forest-deep/40 backdrop-blur-sm" aria-label={`Serving ${SITE.areasServed.join(', ')}`}>
		<div class="hero-marquee-track font-sans text-[10px] md:text-[11px] uppercase tracking-[0.28em] text-ivory/45 py-2">
			{
				areas.map((area) => (
					<span class="inline-flex items-center gap-4 px-4 whitespace-nowrap">
						<span>Serving {area}</span>
						<span class="text-gold/40" aria-hidden="true">·</span>
					</span>
				))
			}
		</div>
	</div>
</section>

<style>
	.hero-premium-glow {
		background:
			radial-gradient(ellipse 70% 50% at 75% 25%, rgba(196, 160, 53, 0.1) 0%, transparent 55%),
			radial-gradient(ellipse 50% 40% at 15% 75%, rgba(42, 74, 58, 0.35) 0%, transparent 50%);
	}

	.hero-stagger {
		opacity: 0;
		transform: translateY(20px);
		animation: heroFadeUp 0.85s ease-out forwards;
	}

	.hero-stagger-1 { animation-delay: 0.08s; }
	.hero-stagger-2 { animation-delay: 0.18s; }
	.hero-stagger-3 { animation-delay: 0.28s; }
	.hero-stagger-4 { animation-delay: 0.38s; }
	.hero-stagger-5 { animation-delay: 0.48s; }

	@keyframes heroFadeUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-marquee {
		overflow: hidden;
	}

	.hero-marquee-track {
		display: flex;
		width: max-content;
		animation: heroMarquee 28s linear infinite;
	}

	@keyframes heroMarquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	.btn-ghost-hero {
		background: transparent !important;
		border-color: rgba(219, 184, 74, 0.45) !important;
		color: rgba(250, 248, 244, 0.9) !important;
		box-shadow: none !important;
	}

	.btn-ghost-hero:hover {
		background: rgba(196, 160, 53, 0.12) !important;
		border-color: rgba(219, 184, 74, 0.75) !important;
		color: #dbb84a !important;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-stagger {
			opacity: 1;
			transform: none;
			animation: none;
		}
		.hero-marquee-track {
			animation: none;
		}
	}
</style>

<script>
	(() => {
		const hero = document.querySelector<HTMLElement>('[data-hero]');
		const parallax = document.querySelector<HTMLElement>('[data-hero-parallax]');
		const floatEl = document.querySelector<HTMLElement>('[data-hero-float]');
		if (!hero || !parallax) return;

		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduce) return;

		const onMove = (e: PointerEvent) => {
			if (e.pointerType === 'touch') return;
			const rect = hero.getBoundingClientRect();
			const x = (e.clientX - rect.left) / rect.width - 0.5;
			const y = (e.clientY - rect.top) / rect.height - 0.5;
			parallax.style.transform = `translate3d(${x * 18}px, ${y * 12}px, 0)`;
			if (floatEl) {
				floatEl.style.transform = `translate3d(${x * -10}px, ${y * -8}px, 0)`;
			}
		};

		hero.addEventListener('pointermove', onMove, { passive: true });
		hero.addEventListener(
			'pointerleave',
			() => {
				parallax.style.transform = '';
				if (floatEl) floatEl.style.transform = '';
			},
			{ passive: true },
		);
	})();
</script>
